[
  {
    "output": ["eDP-1"],
    "spacing": 5,
    "modules-left": [
      "hyprland/workspaces",
      "cpu",
      "memory",
      "temperature",
      "network",
    ],
    "modules-center": [
      "hyprland/window",
      "custom/seek-back",
      "mpris",
      "custom/seek-forward",
    ],
    "modules-right": [
      "custom/hue",
      "backlight",
      "wireplumber",
      "tray",
      "custom/all-app-updates",
      "custom/notification",
      "custom/weather",
      "clock",
      "battery",
      "custom/power",
    ],
    "hyprland/workspaces": {
      "format": "{name}",
      "on-click": "activate",
      "all-outputs": false,
      "show-special": false,
      "persistent-workspaces": {},
    },
    "hyprland/window": {
      "format": "{title}",
      "max-length": 60,
      "separate-outputs": true,
    },
    "tray": {
      "icon-size": 14,
      "spacing": 10,
    },
    "clock": {
      "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
      "format": "{:%H:%M}",
      "format-alt": "{:%a %F}",
    },
    "backlight": {
      "scroll-step": 5,
      "format": "{icon} {percent}%",
      "format-icons": ["󰃞", "󰃟", "󰃠"],
      "on-scroll-up": "brightnessctl set 5%+",
      "on-scroll-down": "brightnessctl set 5%-",
      "on-click": "brightnessctl set 10%",
      "tooltip": false,
    },
    "wireplumber": {
      "scroll-step": 5,
      "format": "{icon} {volume}%",
      "format-bluetooth": "{icon} {volume}%",
      "format-bluetooth-muted": "󰖁 {icon}",
      "format-muted": "󰖁 ",
      "format-icons": {
        "headphone": "󰋋",
        "hands-free": "󰋎",
        "headset": "󰋎",
        "phone": "󰏲",
        "portable": "󰦢",
        "car": "󰄋",
        "default": ["󰕿", "󰖀", "󰕾"],
      },
      "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
      "on-click-right": "pavucontrol",
    },
    "network": {
      "format-wifi": "󰤨 {bandwidthTotalBytes}",
      "format-ethernet": "󰈀 {bandwidthTotalBytes}",
      "format-linked": "󰈁 {ifname}",
      "format-disconnected": "󰤭 Disconnected",
      "tooltip-format": "{ifname} via {gwaddr}",
      "tooltip-format-wifi": "{essid} ({signalStrength}%)",
      "on-click": "nm-connection-editor",
    },
    "cpu": {
      "format": "  {usage}%",
      "tooltip": true,
      "interval": 1,
    },
    "memory": {
      "format": "  {used:0.1f}G/{total:0.1f}G",
      "tooltip": true,
      "interval": 5,
    },
    "temperature": {
      "critical-threshold": 90,
      "interval": 4,
      "format": "{icon} {temperatureC}°",
      "format-icons": ["", "", "", "", ""],
      "tooltip": false,
    },
    "custom/all-app-updates": {
      "format": "󰚰 {}",
      "exec": "~/.config/waybar/scripts/check_all_updates.sh",
      "interval": 600,
      "tooltip": false,
      "on-click": "kitty -e ~/.config/waybar/scripts/open_update_terminal.sh",
      "signal": 8,
    },
    "mpris": {
      "format": "⏸ {title}",
      "format-paused": "▶ {title}",
      "format-stopped": "",
      "player-icons": {
        "spotify": "",
        "vlc": "",
        "default": "🎵",
      },
      "tooltip": true,
      "tooltip-format": "{title} by {artist} on {album}",
      "on-click": "playerctl play-pause",
      "on-scroll-up": "playerctl next",
      "on-scroll-down": "playerctl previous",
    },
    "custom/seek-back": {
      "exec": "~/.config/waybar/scripts/mpris_seek_backward.sh",
      "interval": 5,
      "on-click": "~/.config/waybar/scripts/mpris_seek_backward.sh click",
      "tooltip": false,
    },
    "custom/seek-forward": {
      "exec": "~/.config/waybar/scripts/mpris_seek_forward.sh",
      "interval": 5,
      "on-click": "~/.config/waybar/scripts/mpris_seek_forward.sh click",
      "tooltip": false,
    },
    "custom/hue": {
      "exec": "~/.config/waybar/scripts/hue_control.sh",
      "interval": 10,
      "return-type": "json",
      "tooltip": true,
      "on-click": "~/.config/waybar/scripts/hue_control.sh toggle",
      "on-scroll-up": "~/.config/waybar/scripts/hue_control.sh bri 20",
      "on-scroll-down": "~/.config/waybar/scripts/hue_control.sh bri -20",
    },
    "battery": {
      "states": {
        "warning": 30,
        "critical": 15,
      },
      "format": "{icon} {capacity}%",
      "format-full": "{icon} {capacity}%",
      "format-charging": "󰂄 {capacity}% · {time}",
      "format-plugged": "󰚥 {capacity}%",
      "format-alt": "{icon} {time}",
      "format-icons": ["󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
      "tooltip": true,
      "tooltip-format": "{capacity}% | {power:.1f}W | {time}",
      "on-click": "bash -c 'case $(powerprofilesctl get) in performance) powerprofilesctl set balanced;; balanced) powerprofilesctl set power-saver;; power-saver) powerprofilesctl set performance;; esac'",
    },
    "custom/weather": {
      "exec": "~/.config/waybar/scripts/weather.sh",
      "interval": 3600,
      "return-type": "json",
      "format": "{}",
    },
    "custom/notification": {
      "tooltip": false,
      "format": "󰂚 {text}",
      "format-icons": {
        "notification": "<span foreground='#f38ba8'><sup></sup></span>",
        "none": "",
        "dnd-notification": "<span foreground='#f38ba8'><sup></sup></span>",
        "dnd-none": "",
        "inhibited-notification": "<span foreground='#f38ba8'><sup></sup></span>",
        "inhibited-none": "",
        "dnd-inhibited-notification": "<span foreground='#f38ba8'><sup></sup></span>",
        "dnd-inhibited-none": "",
      },
      "return-type": "json",
      "exec-if": "which swaync-client",
      "exec": "swaync-client -swb",
      "on-click": "swaync-client -t -sw",
      "on-click-right": "swaync-client -d -sw",
      "escape": true,
    },
    "custom/power": {
      "format": "⏻",
      "on-click": "wlogout --layout ~/.config/wlogout/layout --css ~/.config/wlogout/style.css --buttons-per-row 1 --column-spacing 0 --row-spacing 1 --margin-top 50 --margin-right 40 --margin-bottom 1420 --margin-left 2470",
      "tooltip": false,
    },
  },
  {
    "output": ["HDMI-A-1"],
    "spacing": 4,
    "modules-left": [
      "hyprland/workspaces",
